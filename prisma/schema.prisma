generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id        String     @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  company   String?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  caseFiles CaseFile[]
  documents Document[]
  emailThreads EmailThread[]

  @@index([firstName])
  @@index([email])
}

model CaseFile {
  id        String     @id @default(cuid())
  serialNo  Int        @unique
  title     String?
  clientId  String?
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]
}

model Document {
  id              String         @id @default(cuid())
  type            String
  status          String         @default("DRAFT")
    documentNo      String
    confirmationToken String?      @unique
    bookingConfirmed Boolean       @default(false)
    confirmedAt     DateTime?
    caseFileId      String?
  caseFile        CaseFile?      @relation(fields: [caseFileId], references: [id], onDelete: SetNull)
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  parentDocumentId String?
  parentDocument  Document?      @relation("DocumentRevisions", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  revisions       Document[]     @relation("DocumentRevisions")
  rootDocumentId  String?
  revisionNo      Int            @default(1)
  issueDate       DateTime?
  dueDate         DateTime?
  bookingDate     DateTime?
  jobTitle        String
  description     String?
  greeting        String?
  emailNote       String?
  cc              String?
  phoneNo         String?
  postalCode      String?
  addressLine     String?
  extraAddress    String?
  selectedAddress String?
  hasOccupier     Boolean        @default(false)
  occupierFirstName String?
  occupierLastName String?
  occupierPhone   String?
  occupierPostalCode String?
  occupierAddressLine String?
  occupierExtraAddress String?
  occupierSelectedAddress String?
  price           Decimal      @default(0)
  includeOptions  String?
  sendMail        Boolean      @default(false)
  sendImages      Boolean      @default(false)
  invoiceCheck    Boolean      @default(false)
  emailSubject    String?
  emailBody       String?
  pdfNotes        String?
  emailStatus     String       @default("NOT_SENT")
  emailError      String?
  subtotal        Decimal        @default(0)
  total           Decimal        @default(0)
  paidAmount      Decimal        @default(0)
  paymentStatus   String         @default("NOT_PAID")
  paymentUrl      String?
  pdfUrl          String?
  sentAt          DateTime?
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lineItems       LineItem[]
  attachments     Attachment[]
  emailThreads    EmailThread[]
  paymentRecords  PaymentRecord[]

  @@unique([documentNo, revisionNo])
  @@index([type])
  @@index([caseFileId])
  @@index([clientId])
  @@index([rootDocumentId])
}

model LineItem {
  id          String       @id @default(cuid())
  documentId  String
  document    Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind        String
  title       String
  description String?
  quantity    Decimal      @default(1)
  unitPrice   Decimal      @default(0)
  total       Decimal      @default(0)
  sortOrder   Int          @default(0)
}


model Attachment {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name       String
  mimeType   String?
  size       Int?
  dataUrl    String
  createdAt  DateTime @default(now())

  @@index([documentId])
}

model EmailThread {
  id           String         @id @default(cuid())
  subject      String
  normalizedSubject String?
  fromEmail    String?
  fromName     String?
  toEmail      String?
  documentId   String?
  document     Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  unreadCount  Int            @default(0)
  isStarred    Boolean        @default(false)
  archivedAt   DateTime?
  trashedAt    DateTime?
  deletedAt    DateTime?
  lastMessageAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  messages     EmailMessage[]

  @@index([documentId])
  @@index([clientId])
  @@index([isStarred])
  @@index([archivedAt])
  @@index([trashedAt])
  @@index([deletedAt])
  @@index([lastMessageAt])
}

model EmailMessage {
  id          String      @id @default(cuid())
  threadId    String
  thread      EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  replyToMessageId String?
  replyToMessage EmailMessage? @relation("EmailMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies     EmailMessage[] @relation("EmailMessageReplies")
  uid         Int?
  messageId   String?     @unique
  direction   String
  fromEmail   String?
  fromName    String?
  toEmail     String?
  subject     String
  textBody    String?
  htmlBody    String?
  isRead      Boolean     @default(false)
  sentAt      DateTime?
  createdAt   DateTime    @default(now())
  attachments EmailAttachment[]

  @@index([threadId])
  @@index([replyToMessageId])
  @@index([uid])
  @@index([direction])
  @@index([isRead])
}

model EmailAttachment {
  id          String       @id @default(cuid())
  messageId   String
  message     EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name        String
  mimeType    String?
  size        Int?
  content     Bytes
  createdAt   DateTime     @default(now())

  @@index([messageId])
}

model Counter {
  id       String @id
  nextSeq  Int    @default(1)
}

model PaymentRecord {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  amount     Decimal  @default(0)
  note       String?
  method     String   @default("BANK_TRANSFER")
  paidAt     DateTime @default(now())

  @@index([documentId])
}


